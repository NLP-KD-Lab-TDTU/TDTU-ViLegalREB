# Optional mode override: "dev" or "production"
# Leave commented out to auto-switch (`npm run dev` -> dev URL, `npm run build` -> production URL)
# VITE_API_MODE=production

# Local backend URL (dev mode)
VITE_LOCAL_API_BASE=hehe

# Production backend URL on Render (production mode)
VITE_API_BASE=hehe

# Base path for GitHub Pages project site (e.g. /TDTU-ViLegalREB/), or / for local/custom domain
# VITE_BASE_PATH=/TDTU-ViLegalREB/

